# PostgreSQL connection string
DATABASE_URL=postgres://user:password@host:5432/bible_challenge
# Set to "true" when your database requires TLS (most hosted Postgres providers)
DATABASE_SSL=false

# Stable key for encrypting Server Action references across deploys/instances.
# Generate with: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Used once by `npm run db:seed` to create the first admin account.
ADMIN_USERNAME=admin
ADMIN_DISPLAY_NAME=Leader
ADMIN_PASSWORD=

# Set to "true" only if the app sits behind a proxy you trust to set X-Forwarded-For
TRUST_PROXY=false
